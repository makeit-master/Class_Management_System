{
  "name": "class-management-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@cms/web",
    "dev:web": "npm run dev --workspace=@cms/web",
    "dev:api": "npm run dev --workspace=@cms/api",
    "build": "npm run build --workspace=@cms/web",
    "lint": "npm run lint --workspace=@cms/web",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "lucide-react": "^1.66.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6"
  }
}
